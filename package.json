{
  "name": "redactpal",
  "version": "0.1.0",
  "description": "Redact screenshots, PDFs and text before you share them. Runs 100% in your browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
